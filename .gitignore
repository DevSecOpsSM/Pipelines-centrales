# ═══════════════════════════════════════════════════════════════════════════
# .gitignore — Pipelines-centrales
# ═══════════════════════════════════════════════════════════════════════════

# Claude Code — configuración y documentación interna (no versionadas)
Claude.md
.claude/

# Reportes generados localmente por los workflows
reports/
*.html.bak

# Logs
*.log
*.log.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Pre-commit cache
.pre-commit-cache/

# IDE / editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Temporales
*.tmp
*.temp
*.bak

# Docs de referencia interna (Confidencial — no versionar)
docs/Reporte_*.docx
docs/*_interno.docx

# Dumps de escaneos reales usados para probar plantillas localmente
docs/*-raw*.json
docs/checkov-raw*.json
docs/trivy-raw*.json
docs/semgrep-raw*.json
docs/gitleaks-raw*.json
