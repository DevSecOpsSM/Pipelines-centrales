# ═══════════════════════════════════════════════════════════════════════════
# .gitattributes — Normalización EOL
# Garantiza consistencia entre Windows (CRLF) y Linux/macOS (LF).
# Crítico para workflows GitHub Actions que se ejecutan en Ubuntu runners.
# ═══════════════════════════════════════════════════════════════════════════

# Por defecto: detección automática, EOL = LF en checkout
* text=auto eol=lf

# Workflows y configuración — SIEMPRE LF (parser GHA es estricto)
*.yml       text eol=lf
*.yaml      text eol=lf

# Scripts ejecutados en Linux runners
*.py        text eol=lf
*.sh        text eol=lf

# Documentación
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf

# Binarios — no aplicar conversión
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
